{
  "name": "tyaga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "bot": "tsx src/bot/index.ts",
    "catalog:seed-mock": "tsx scripts/catalog-seed-mock.ts",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "bench:catalog": "tsx scripts/bench-catalog.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.4",
    "@telegram-apps/init-data-node": "^2.0.10",
    "@telegram-apps/sdk-react": "^3.3.9",
    "dotenv": "^18.0.8",
    "framer-motion": "^14.3.0",
    "grammy": "^1.46.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "jotai": "^3.0.1",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^7.0.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "zod-prisma-types": "^3.3.11"
  }
}
