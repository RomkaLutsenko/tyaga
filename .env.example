DATABASE_URL="postgresql://tyaga:tyaga@localhost:5433/tyaga?schema=public"
REDIS_URL="redis://localhost:6380"

# open | telegram_only. Missing or invalid values start as telegram_only.
ACCESS_MODE="open"

# Telegram bot and Mini App initData validation
BOT_TOKEN=""
WEBAPP_URL="http://localhost:3000"
TELEGRAM_WEBHOOK_SECRET=""

# Dev only. Accepts Authorization: tma mock when NODE_ENV is not production.
ALLOW_MOCK_INIT_DATA="false"

# JWT age token (jose). Use a long random string.
AUTH_SECRET=""

# Public flags
CATEGORY_LIQUID_ENABLED="true"
CATALOG_IMAGES_ENABLED="false"
SHOW_PRICES="false"
AGE_GATE_COOLDOWN_HOURS="24"
AGE_TOKEN_TTL_HOURS="24"
INIT_DATA_MAX_AGE_HOURS="24"

# Comma-separated browser origins. Empty keeps the app same-origin.
CORS_ORIGINS=""

# memory skips Redis. Leave unset to use REDIS_URL.
RATE_LIMIT_DRIVER=""
